# CypherID environment template (docs/infrastructure/13_ENVIRONMENT_CONFIGURATION.md)
# Copy to .env and fill in real secrets. .env is never committed.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=cypherid
POSTGRES_USER=cypherid
POSTGRES_PASSWORD=cypherid_secret

# ── JWT ───────────────────────────────────────────────────────────────────────
# Access-token signing key (must be at least 256 bits / 32 bytes)
JWT_SECRET=CypherID-SIH-2026-Super-Secret-Key-Must-Be-At-Least-256-Bits-Long!

# ── Fabric (Phase 2) ──────────────────────────────────────────────────────────
FABRIC_CHANNEL=cypherid-channel
FABRIC_ORG_MSP=Org1MSP
FABRIC_PEER_ENDPOINT=peer0.org1.cypherid.com:7051
FABRIC_PEER_OVERRIDE_AUTHORITY=peer0.org1.cypherid.com

# ── Asset master encryption key (wraps per-asset AES-256 keys at rest) ───────
# Generate a random 32-byte key in production: openssl rand -base64 32
ASSET_MASTER_KEY=CypherID-Asset-Master-Key-2026!!